{
	"redirects": [
		{
			"source": "/(.*)",
			"has": [
				{
					"type": "host",
					"value": "uiguy.dev"
				}
			],
			"destination": "https://www.uiguy.dev/$1",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "index, follow"
				}
			]
		}
	]
}
